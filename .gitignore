# =========================================================
# CONFIGURACIÓN DE EXCLUSIONES PARA EL REPOSITORIO GIT
# =========================================================

# Compilaciones y ejecutables locales
build/
dist/
*.spec
*.exe
tensiometro_reconstructed.exe
tensiometro-final (1).exe

# Carpetas de extracción y descompresión
*_extracted/
*.exe_extracted/

# Cache de Python y checkpoints
__pycache__/
*.pyc
*.pyo
*.pyd
*.ipynb_checkpoints/
*_backup.py

# Aplicación Web (excluida para dejar solo la app de escritorio)
landing/

# Formatos de texto intermedios (solo se conservan los PDF en el repositorio)
*.docx
*.md
convert_*.py
generate_*.py
docs_img/

# Scripts de utilidad local y notebooks de investigación
color.ipynb
extract.py
pyinstxtractor.py
test_*.py

# Versiones de prueba y datasets masivos (>100MB)
firmware_v1/
firmware_v2/
Baumanometro/
*.mat
*.zip

# Scripts de automatización locales
push.bat
push_to_github.bat
